{
  "name": "§0Symbiote Creation",
  "description": "He is able to forge different types of symbiotes with various abilities.",
  "type": "origins:multiple",
  "summon": {
    "type": "origins:active_self",
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "command": "/summon minecraft:husk ~ ~ ~ {CustomName:\"\\\"§0Symbiote Husk 1\\\"\",Tags:[\"tamed\"],Team:king,ArmorItems:[{},{},{},{id:\"minecraft:leather_helmet\",Count:1b,tag:{display:{color:0}}}],Attributes:[{Name:generic.max_health,Base:400},{Name:generic.attack_damage,Base:48},{Name:generic.movement_speed,Base:1.6}],Health:400f}"
        },
        {
          "type": "origins:execute_command",
          "command": "/summon minecraft:husk ~ ~ ~ {CustomName:\"\\\"§0Symbiote Husk 2\\\"\",Tags:[\"tamed\"],Team:king,ArmorItems:[{},{},{},{id:\"minecraft:leather_helmet\",Count:1b,tag:{display:{color:0}}}],Attributes:[{Name:generic.max_health,Base:400},{Name:generic.attack_damage,Base:48},{Name:generic.movement_speed,Base:1.6}],Health:400f}"
        },
        {
          "type": "origins:execute_command",
          "command": "/summon minecraft:evoker ~ ~ ~ {CustomName:\"\\\"§0Symbiote Evoker\\\"\",Tags:[\"tamed\"],Team:king,ArmorItems:[{},{},{},{id:\"minecraft:leather_helmet\",Count:1b,tag:{display:{color:0}}}],Attributes:[{Name:generic.max_health,Base:320},{Name:generic.attack_damage,Base:60},{Name:generic.movement_speed,Base:2.0}],Health:320f}"
        },
        {
          "type": "origins:play_sound",
          "sound": "entity.evoker_fangs.attack",
          "volume": 1,
          "pitch": 1
        }
      ]
    },
    "cooldown": 200,
    "hud_render": {
      "should_render": true,
      "sprite_location": "origins:textures/gui/community/spiderkolo/resource_bar_02.png",
      "bar_index": 17
    },
    "key": {
      "key": "key.saveToolbarActivator"
    }
  },
  "create_team": {
    "type": "origins:action_on_callback",
    "execute_chosen_when_orb": true,
    "entity_action_added": {
      "type": "origins:execute_command",
      "permission_level": 4,
      "command": "team add king"
    },
    "entity_action_removed": {
      "type": "origins:execute_command",
      "permission_level": 4,
      "command": "team leave @s"
    }
  },
  "join_team": {
    "type": "origins:action_over_time",
    "interval": 20,
    "entity_action": {
      "type": "origins:and",
      "actions": [
        {
          "type": "origins:execute_command",
          "permission_level": 4,
          "command": "team join king @s"
        },
        {
          "type": "origins:execute_command",
          "permission_level": 4,
          "command": "team join king @e[tag=tamed,distance=..64]"
        }
      ]
    }
  },
  "on_hit": {
    "type": "origins:action_on_hit",
    "bientity_action": {
      "type": "origins:target_action",
      "action": {
        "type": "origins:area_of_effect",
        "radius": 20,
        "bientity_condition": {
          "type": "origins:target_condition",
          "condition": {
            "type": "origins:and",
            "conditions": [
              {
                "type": "origins:command",
                "command": "execute if entity @s[team=king]",
                "comparison": ">=",
                "compare_to": 1
              },
              {
                "type": "origins:entity_type",
                "entity_type": "minecraft:husk"
              }
            ]
          }
        },
        "bientity_action": {
          "type": "origins:damage",
          "amount": 40,
          "source": {
            "name": "mob",
            "bypasses_armor": true,
            "unblockable": true,
            "out_of_world": true
          }
        }
      }
    },
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    }
  },
  "when_hit": {
    "type": "origins:action_when_hit",
    "bientity_action": {
      "type": "origins:actor_action",
      "action": {
        "type": "origins:area_of_effect",
        "radius": 20,
        "bientity_condition": {
          "type": "origins:target_condition",
          "condition": {
            "type": "origins:and",
            "conditions": [
              {
                "type": "origins:command",
                "command": "execute if entity @s[team=king]",
                "comparison": ">=",
                "compare_to": 1
              },
              {
                "type": "origins:entity_type",
                "entity_type": "minecraft:evoker"
              }
            ]
          }
        },
        "bientity_action": {
          "type": "origins:damage",
          "amount": 40,
          "source": {
            "name": "mob",
            "bypasses_armor": true,
            "unblockable": true,
            "out_of_world": true
          }
        }
      }
    },
    "cooldown": 1,
    "hud_render": {
      "should_render": false
    }
  }
}
